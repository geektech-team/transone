{
  "name": "transone-cli",
  "version": "0.3.1",
  "description": "Bun-native multi-target compiler CLI for TransOne applications: 一份 TypeScript 源码，按 Target 静态转换为 Web 与多端小程序原生工程",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "transone": "bin/transone.ts"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:types": "bunx tsc --project tsconfig.build.json",
    "lint": "eslint . --ext .ts",
    "test": "bun test"
  },
  "dependencies": {
    "transone": "workspace:*",
    "typescript": "^5.3.3"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://geektech-team.github.io/transone/cli/",
  "engines": {
    "bun": ">=1.3.0"
  }
}
